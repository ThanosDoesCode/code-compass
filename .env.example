# Server-only: injected by Lovable-managed Supabase in its runtime.
# Set these only when running the server independently of Lovable.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PUBLISHABLE_KEY=

# Server-only: configure in Lovable Secrets.
ANTHROPIC_API_KEY=

# Browser-safe Supabase Auth configuration. Lovable injects these for connected projects.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
